// The relay: one Linux container group with one container and a public IP that exposes ONE UDP port.
// There is no TCP port. The image is pulled with the managed identity (AcrPull), so no registry password exists.

targetScope = 'resourceGroup'

@description('Container group name.')
param containerGroupName string

@description('Azure region of the container group.')
param location string

@description('Full image reference by digest, for example myregistry.azurecr.io/wpiemu-relay@sha256:...')
@minLength(1)
param image string

@description('Login server of the registry the image comes from.')
param registryLoginServer string

@description('Resource id of the user-assigned managed identity that holds AcrPull on the registry.')
param identityId string

@description('DNS name label; the FQDN is <label>.<region>.azurecontainer.io with the Unsecure reuse policy, and <label>.<hash>.<region>.azurecontainer.io with any other.')
@minLength(1)
@maxLength(63)
param dnsNameLabel string

@description('''Who may re-use the DNS label after the container group is deleted. Unsecure is the default because it is the only
policy that keeps the FQDN predictable: every other policy inserts a hash label (<label>.<hash>.<region>.azurecontainer.io), but the
apps build the relay name from the suffix alone (app/ui/relay_endpoints.h), so a hashed name never resolves for them. The price is
that anyone can claim the label after the relay is deleted. That cannot expose game data (traffic is end-to-end encrypted and the
relay sees only the room id and ciphertext) but a squatter could deny service, so treat deleting a relay as retiring its name. The
policy cannot be changed in place: a container group has to be deleted and re-created.''')
@allowed([
  'NoReuse'
  'ResourceGroupReuse'
  'SubscriptionReuse'
  'TenantReuse'
  'Unsecure'
])
param dnsNameLabelReusePolicy string = 'Unsecure'

@description('UDP port the relay listens on and the container group exposes.')
@minValue(1)
@maxValue(65535)
param udpPort int

@description('vCPUs of the container (a decimal string such as "0.5").')
param cpu string

@description('Memory of the container in GB (a decimal string such as "1.0").')
param memoryGb string

@description('Relay limits and options as environment variables (WPIEMU_RELAY_*). Not secret: the relay has no secrets.')
param relayEnvironment array

@description('Name of the Log Analytics workspace (in this resource group) that receives the container logs.')
param logAnalyticsWorkspaceName string

@description('Tags applied to the container group.')
param tags object

resource workspace 'Microsoft.OperationalInsights/workspaces@2025-02-01' existing = {
  name: logAnalyticsWorkspaceName
}

resource relay 'Microsoft.ContainerInstance/containerGroups@2025-09-01' = {
  name: containerGroupName
  location: location
  tags: tags
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: {
      '${identityId}': {}
    }
  }
  properties: {
    osType: 'Linux'
    sku: 'Standard'
    restartPolicy: 'Always'
    imageRegistryCredentials: [
      {
        server: registryLoginServer
        identity: identityId
      }
    ]
    ipAddress: {
      type: 'Public'
      dnsNameLabel: dnsNameLabel
      autoGeneratedDomainNameLabelScope: dnsNameLabelReusePolicy
      ports: [
        {
          protocol: 'UDP'
          port: udpPort
        }
      ]
    }
    diagnostics: {
      logAnalytics: {
        workspaceId: workspace.properties.customerId
        workspaceKey: workspace.listKeys().primarySharedKey
        logType: 'ContainerInstanceLogs'
      }
    }
    containers: [
      {
        name: 'relay'
        properties: {
          image: image
          ports: [
            {
              protocol: 'UDP'
              port: udpPort
            }
          ]
          environmentVariables: relayEnvironment
          resources: {
            requests: {
              cpu: json(cpu)
              memoryInGB: json(memoryGb)
            }
          }
          // wpiemu_relay --selfcheck asks the running relay about a random, non-existent room and expects a refusal, so it
          // creates no room and changes no state; it reads WPIEMU_RELAY_PORT from the container environment.
          // The check takes under 2 s. A 30 s period keeps the probe's own failed lookups well below the relay's
          // failed-join lockout (10 per 60 s per source); three misses (about 90 s) restart the container.
          livenessProbe: {
            exec: {
              command: [
                'wpiemu_relay'
                '--selfcheck'
              ]
            }
            initialDelaySeconds: 15
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
            successThreshold: 1
          }
        }
      }
    ]
  }
}

output fqdn string = relay.properties.ipAddress.fqdn
output ip string = relay.properties.ipAddress.ip
output containerGroupId string = relay.id
