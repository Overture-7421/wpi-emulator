# practice-match client packages. Run with `cpack --config CPackClientConfig.cmake -C Release -B <output directory>`.
include("@CMAKE_BINARY_DIR@/CPackConfig.cmake")

set(CPACK_GENERATOR "@WPIEMU_CLIENT_PACKAGE_GENERATOR@")
set(CPACK_PACKAGE_NAME "WPI Emulator Client")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Join a WPI Emulator practice match")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "WPI Emulator Client")
set(CPACK_PACKAGE_FILE_NAME "@WPIEMU_CLIENT_PACKAGE_FILE_NAME@")
